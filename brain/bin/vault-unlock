#!/usr/bin/env python3
"""vault-unlock — complete MFA step-up and cache the loa3 JWT.

Brain's vault value endpoints require an MFA-fresh JWT (acr=loa3).
This command opens the user's browser to Keycloak, runs the standard
auth-code + PKCE flow (password + WebAuthn / TOTP / FIDO depending on
realm config), captures the redirect on a loopback port, exchanges the
code for an access token, and caches it in libsecret.

After unlock, ``vault-resolve`` and ``vault-run`` can fetch values until
the loa3 freshness window expires. That window is a SERVER setting
(``ACR_LOA3_MAX_AGE_SECONDS``, default 300 s) read from
``/api/v1/vault/policy`` — it is measured from the moment MFA completed
(``auth_time``), not from token issue, and it is shorter than the token's
own lifetime. ``--status`` prints how much of it is left.

Encryption is server-side; the plugin doesn't manage any key material.
If you have enrolled factor-derived vault keys (#48), there is a second
lock: Brain can only open your values while the vault key is unlocked in
the portal (passkey or recovery key). After MFA, vault-unlock checks that
too and, if it is locked, opens the portal unlock page and waits for it.
``--status`` reports both windows.

Only the SECOND FACTOR is re-challenged. loa3 expires; loa1 does not, so
an existing Keycloak SSO session keeps satisfying it and you should not be
asked for a username and password on a routine unlock. If you are, the
realm's loa3 conditional subflow is misconfigured — see --force-login.

Usage:
    vault-unlock              # step-up MFA only, cache JWT
    vault-unlock --status     # print whether unlocked + freshness left
    vault-unlock --clear      # clear cached JWT
    vault-unlock --force      # re-authenticate even if cache is fresh
    vault-unlock --force-login  # full username+password re-auth (escape hatch)
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _vault_common import (  # noqa: E402
    discover_brain_url, get_cached_jwt, mint_loa3_jwt, clear_cached_jwt,
    _decode_jwt_email, _read_with_expiry, fetch_loa3_window, jwt_auth_age,
    VaultCliError, fetch_unlock_status, vault_namespace, wait_for_unlock,
)


def _key_status(jwt: str):
    """Server-side vault key status, or None if there is nothing to unlock."""
    try:
        return fetch_unlock_status(vault_namespace(), jwt)
    except VaultCliError as e:
        print(f"vault: could not check the vault key status ({e})", file=sys.stderr)
        return None


def _key_status_line(jwt: str) -> str:
    st = _key_status(jwt)
    if st is None or not st.get("enrolled"):
        return ""
    if st.get("locked"):
        return "; vault key locked — values need a portal unlock"
    return f"; vault key unlocked for ~{st.get('expires_in', 0)}s"


def _ensure_key_unlocked(jwt: str) -> int:
    """After MFA: if the vault key is enrolled and locked, run the portal unlock."""
    st = _key_status(jwt)
    if st is None or not st.get("enrolled") or not st.get("locked"):
        return 0
    if wait_for_unlock(st.get("namespace") or vault_namespace(), jwt, st["unlock_url"]):
        return 0
    print(
        "vault: MFA is done but the vault key is still locked — finish the "
        "unlock in the portal, then retry",
        file=sys.stderr,
    )
    return 1


def main(argv: list[str]) -> int:
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0

    brain_url = discover_brain_url()

    if "--clear" in argv:
        clear_cached_jwt(brain_url)
        print("vault: cache cleared")
        return 0

    # An unexpired token authenticates the policy lookup even when it is
    # already too stale to spend on a value read — /vault/policy carries
    # no acr requirement.
    unexpired = _read_with_expiry(kind="jwt", account=brain_url)
    window = fetch_loa3_window(unexpired)
    # "Unlocked" has to mean what the SERVER means by it. Judging the cache
    # by the token's own `exp` alone reported unlocked for ~15 min while
    # value reads started failing after `window` seconds, and then declined
    # to re-authenticate because a token was present — an unlock loop with
    # no exit (issue #192).
    cached_jwt = get_cached_jwt(brain_url, max_auth_age=window)

    if "--status" in argv:
        if cached_jwt:
            email = _decode_jwt_email(cached_jwt) or "(unknown)"
            left = window - (jwt_auth_age(cached_jwt) or 0)
            print(f"vault: unlocked for {email} — ~{left}s of loa3 freshness left"
                  f"{_key_status_line(cached_jwt)}")
            return 0
        if unexpired:
            age = jwt_auth_age(unexpired)
            detail = f"last MFA {age}s ago" if age is not None else "no auth_time claim"
            print(
                f"vault: locked — cached token is unexpired but stale "
                f"({detail}, server accepts {window}s). Run `vault-unlock`."
            )
            return 1
        print("vault: locked — run `vault-unlock` to complete MFA")
        return 1

    if cached_jwt and "--force" not in argv:
        email = _decode_jwt_email(cached_jwt) or brain_url
        left = window - (jwt_auth_age(cached_jwt) or 0)
        print(
            f"vault: already unlocked for {email} — ~{left}s left "
            "(use --force to re-authenticate)"
        )
        return _ensure_key_unlocked(cached_jwt)

    jwt, _expires_at = mint_loa3_jwt(
        prompt=True, force_full_login="--force-login" in argv
    )
    email = _decode_jwt_email(jwt) or "(could not decode email from JWT)"

    # Requesting a step-up without max_age means Keycloak may decide the
    # session ALREADY satisfies loa3 and hand back the original auth_time.
    # That is correct behaviour — unless the realm's loa3 conditional
    # subflow has no max-age, in which case loa3 never expires there and
    # the token can come back older than Brain will accept. Catch it here
    # and name the realm as the fault, rather than silently forcing a full
    # re-login (which is what made every unlock demand a password).
    age = jwt_auth_age(jwt)
    if age is not None and age > window:
        print(
            f"vault: warning — Keycloak returned a session authenticated {age}s ago, "
            f"but Brain only accepts {window}s.\n"
            "  Keycloak considers loa3 still satisfied, so it did not re-challenge.\n"
            "  Fix: set `max-age` on the realm's loa3 conditional subflow (<= "
            f"{window}s).\n"
            "  Workaround for right now: vault-unlock --force-login",
            file=sys.stderr,
        )
    # Report the loa3 window, not the token lifetime. `exp` is several times
    # longer and quoting it is what taught everyone to expect ~15 minutes of
    # working vault access from a token that stops working after `window`.
    print(f"vault: unlocked for {email} — vault reads work for ~{window}s")
    return _ensure_key_unlocked(jwt)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
